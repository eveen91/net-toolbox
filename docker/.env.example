# Copy this file to ".env" (same folder as docker-compose.yml) to override
# defaults. Not required to just get started.

# REPO_URL=https://github.com/eveen91/net-toolbox.git
# BRANCH=main
# VITE_API_BASE_URL=http://localhost:8000
# ROUTER_IP=192.168.1.1

# Extra browser origins allowed to call the backend (comma-separated).
# Set this when you open the frontend from another machine on your LAN:
# CORS_ORIGINS=http://192.168.1.10:3000

# Set COOKIE_SECURE=true when serving the backend behind an HTTPS reverse proxy
# COOKIE_SECURE=true

# Set TRUST_PROXY_HEADERS=true when running behind a trusted reverse proxy
# to use X-Forwarded-For headers for rate limiting
# TRUST_PROXY_HEADERS=true

# Optional secret required to restrict initial admin bootstrap.
# If set, provide this secret when creating the first admin account:
# BOOTSTRAP_SECRET=my-strong-secret


# Optional stable Fernet key for encrypted Confluence credentials. If absent,
# the backend creates a 0600 key inside the persistent tenant data directory.
# Back up the original key securely; changing it does not rotate saved profiles.
# DOCUMENTATION_SECRET_KEY=<base64-encoded Fernet key>
